@page "/messagebox"
@using HelmerDemo.BlazorServerTwo.Application.Components.Features.SharedTabs
@using HelmerDemo.BlazorServerTwo.Application.Components.Shared
@using HelmerDemo.BlazorServerTwo.Application.Features
<PageTitle>Message Box</PageTitle>

@switch (ViewModel.ViewModelState)
{
    case ViewModelState.Loading:
        <Loading />
        break;
    case ViewModelState.Error:
        <ErrorComponent ErrorMessage="@ViewModel.ErrorMessage" />
        break;
    case ViewModelState.Ready:
        foreach (var message in ViewModel.Messages)
        {
            <div class="message message--user">
                <div class="message__wrapper">
                    <p class="message__content">@message.Content</p>
                    <p class="message__timestamp">@message.TimeStamp</p>
                </div>
            </div>
        }
        <EditMessageBox />
        break;
     default:
        <Loading />
        break;
}