@page "/SimpleFormBlazor"
<h3>SimpleFormBlazor</h3>

<p>This is a simple Blazor solution. I want the field below changed, as I enter input for the message. It is a live-stream</p>

<p>Entering Message: @EnteredContent</p>

<hr/>

<EditForm EditContext="@_editContext">
    <DataAnnotationsValidator />

    <div class="form-group">
        <label for="content">Enter your Message: </label>
        <InputTextArea @oninput="@(ui => { Content = (string)ui.Value ?? string.Empty; MessageTextInputEventHandler(ui); })" @ref="_inputTextReference" Id="content" Class="form-control" @bind-Value="Content"> </InputTextArea>
        <ValidationMessage For="@(() => Content)" />
    </div>
</EditForm>