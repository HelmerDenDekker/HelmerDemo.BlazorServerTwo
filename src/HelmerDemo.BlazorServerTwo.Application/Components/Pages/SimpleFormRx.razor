@page "/SimpleFormRx"
<h3>SimpleForm with ReactiveX</h3>

<p>This is a solution wih ReactiveX. I want the field below changed, as I enter input for the message. Also, not a live stream. Changes over when you switch focus.</p>

<p>Entering Message: @EnteredContent</p>

<hr/>

<EditForm EditContext="@_editContext">
    <DataAnnotationsValidator />

    <div class="form-group">
        <label for="content">Enter your Message: </label>
        <InputTextArea Id="content" Class="form-control" @bind-Value="Model.Content" > </InputTextArea>
        <ValidationMessage For="@(() => Model.Content)" />
    </div>
</EditForm>