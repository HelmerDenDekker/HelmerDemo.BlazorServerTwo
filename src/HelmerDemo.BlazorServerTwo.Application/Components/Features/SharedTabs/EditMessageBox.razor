<EditForm EditContext="@_editContext" OnValidSubmit="Submit">
    <DataAnnotationsValidator />

    <div class="form-group">
        <label for="name">Enter your Message: </label>
        <InputTextArea @oninput="@(ui => { ViewModel.MessageFormText = (string)ui.Value ?? string.Empty; MessageTextInputEventHandler(ui); })" @onkeyup="MessageTextKeyUpEventHandler" @ref="_inputTextReference"  Id="name" Class="form-control" @bind-Value="ViewModel.MessageFormText"> </InputTextArea>
        <ValidationMessage For="@(() => ViewModel.MessageFormText)" />
    </div>

    <p>
        <button type="submit">Submit</button>
    </p>
</EditForm>